# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL connection URL (preferred for local development and managed hosting).
# Copy this file to .env and replace the example with your own connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_arena"

# Cloud SQL alternatives used by AI Studio. Leave DATABASE_URL blank to use these.
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"
